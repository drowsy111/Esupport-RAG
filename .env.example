# Copy to .env and replace all CHANGE_ME values. Do not commit .env.
APP_ENV=development
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_PASSWORD=CHANGE_ME_DATABASE
DATABASE_URL=mysql+pymysql://rag:CHANGE_ME_DATABASE@localhost:3306/enterprise_support_rag?charset=utf8mb4
REDIS_URL=redis://localhost:6379/6
# Existing MinIO has no published port. For WSL host processes, use its inspected
# container IP:9000 (local development only), or publish a port explicitly yourself.
MINIO_ENDPOINT=CHANGE_ME_MINIO_HOST:9000
MINIO_ACCESS_KEY=ragadmin
MINIO_SECRET_KEY=CHANGE_ME_STORAGE
MINIO_SECURE=false
MINIO_BUCKET=enterprise-support-rag-documents
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=enterprise_support_rag_v001
EMBEDDING_URL=http://localhost:8001
RERANKER_URL=http://localhost:8002
# Same internal key in API/worker and both model services.
MODEL_SERVICE_KEY=CHANGE_ME_MODEL_INTERNAL_KEY
# Local model directory or Hugging Face model name; revision should be pinned before deployment.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=main
EMBEDDING_VERSION=bge-m3-initial
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=main
MODEL_DEVICE=cpu
MODEL_USE_FP16=false
# Compatible chat-completions endpoint, base URL normally ends in /v1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
UPLOAD_MAX_BYTES=10485760
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=60
# New imports use sentence units; the CHUNK_* options describe the legacy splitter.
SENTENCE_MAX_TOKENS=200
WINDOW_NEIGHBORS=2
WINDOW_MAX_TOKENS=800
EMBEDDING_MAX_LENGTH=1024
DENSE_TOP_K=50
SPARSE_TOP_K=50
FUSION_TOP_K=30
CONTEXT_TOP_K=8
CONTEXT_CHAR_BUDGET=16000
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
# Application-only Compose, reusing the existing external network.
MILVUS_NETWORK=milvus-network
COMPOSE_DATABASE_URL=mysql+pymysql://rag:CHANGE_ME_DATABASE@host.docker.internal:3306/enterprise_support_rag?charset=utf8mb4
COMPOSE_REDIS_URL=redis://milvus-redis:6379/6
# Set to http://embedding:8001 and http://reranker:8002 when using --profile models.
COMPOSE_EMBEDDING_URL=http://host.docker.internal:8001
COMPOSE_RERANKER_URL=http://host.docker.internal:8002
